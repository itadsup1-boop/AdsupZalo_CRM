  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @map("updated_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, id])
  @@index([orgId, category])
}

model AiPromptVersion {
  id         String       @id
  orgId      String       @map("org_id")
  scope      String       @default("global")
  promptType String       @map("prompt_type")
  version    Int
  content    String
  reason     String?
  createdBy  String?      @map("created_by")
  isActive   Boolean      @default(false) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, promptType, version])
  @@index([orgId, promptType, isActive])
}

model AiReviewItem {
  id              String         @id
  orgId           String         @map("org_id")
  teamId          String?        @map("team_id")
  contactId       String?        @map("contact_id")
  conversationId  String?        @map("conversation_id")
  messageId       String?        @map("message_id")
  aiActivityLogId String?        @map("ai_activity_log_id")
  issueType       String         @map("issue_type")
  severity        String         @default("medium")
  status          String         @default("open")
  customerMessage String?        @map("customer_message")
  aiResponse      String?        @map("ai_response")
  reason          String?
  suggestedFix    String?        @map("suggested_fix")
  reviewedBy      String?        @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @map("updated_at")
  aiActivityLog   AiActivityLog? @relation(fields: [orgId, aiActivityLogId], references: [orgId, id], onDelete: Cascade)
  contact         Contact?       @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Cascade)
  conversation    Conversation?  @relation(fields: [orgId, conversationId], references: [orgId, id], onDelete: Cascade)
  org             Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [orgId, reviewedBy], references: [orgId, id], onDelete: NoAction)

  @@unique([orgId, id])
  @@index([orgId, contactId, createdAt])
  @@index([orgId, conversationId, createdAt])
  @@index([orgId, issueType, createdAt])
  @@index([orgId, severity, createdAt])
  @@index([orgId, status, createdAt])
  @@index([orgId, teamId, createdAt])
}

model AssignmentRule {
  id          String       @id
  orgId       String       @map("org_id")
  name        String
  teamId      String?      @map("team_id")
  serviceName String?      @map("service_name")
  source      String?
  priority    Int          @default(100)
  strategy    String       @default("round_robin")
  saleUserIds String[]     @map("sale_user_ids")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @map("updated_at")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [orgId, teamId], references: [orgId, id])

  @@unique([orgId, id])
  @@index([orgId, isActive, priority])
  @@index([orgId, teamId])
}

