model Tag {
  id                  String               @id @default(uuid())
  orgId               String               @map("org_id")
  name                String
  color               String?              @default("#3B82F6")
  description         String?
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  automationWorkflows AutomationWorkflow[]
  contacts            ContactTag[]
  scenarios           MessageScenario[]
  org                 Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, id])
  @@unique([orgId, name])
  @@map("tags")
}

model ContactTag {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  contactId String       @map("contact_id")
  tagId     String       @map("tag_id")
  createdAt DateTime     @default(now()) @map("created_at")
  contact   Contact      @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tag       Tag          @relation(fields: [orgId, tagId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, id])
  @@unique([contactId, tagId])
  @@map("contact_tags")
}

model MessageScenario {
  id                String                @id @default(uuid())
  orgId             String                @map("org_id")
  name              String
  description       String?
  triggerTagId      String?               @map("trigger_tag_id")
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  category          String?
  campaigns         Campaign[]
  steps             MessageScenarioStep[]
  org               Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  triggerTag        Tag?                  @relation(fields: [triggerTagId], references: [id])
  scheduledMessages ScheduledMessage[]

  @@unique([orgId, id])
  @@map("message_scenarios")
}

model MessageScenarioStep {
  id                String             @id @default(uuid())
  orgId             String             @map("org_id")
  scenarioId        String             @map("scenario_id")
  content           String
  delayMinutes      Int                @default(0) @map("delay_minutes")
  orderIndex        Int                @default(0) @map("order_index")
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  absoluteTime      DateTime?          @map("absolute_time")
  delayType         String             @default("relative") @map("delay_type")
  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scenario          MessageScenario    @relation(fields: [orgId, scenarioId], references: [orgId, id], onDelete: Cascade)
  scheduledMessages ScheduledMessage[]

  @@unique([orgId, id])
  @@map("message_scenario_steps")
}

model Campaign {
  id                String             @id @default(uuid())
  orgId             String             @map("org_id")
  name              String
  scenarioId        String             @map("scenario_id")
  zaloAccountId     String             @map("zalo_account_id")
  status            String             @default("draft")
  targetTags        Json               @default("[]")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scenario          MessageScenario    @relation(fields: [orgId, scenarioId], references: [orgId, id], onDelete: Cascade)
  zaloAccount       ZaloAccount        @relation(fields: [orgId, zaloAccountId], references: [orgId, id], onDelete: Cascade)
  scheduledMessages ScheduledMessage[]

  @@unique([orgId, id])
  @@map("campaigns")
}

model ScheduledMessage {
  id            String               @id @default(uuid())
  orgId         String               @map("org_id")
  contactId     String               @map("contact_id")
  scenarioId    String?              @map("scenario_id")
  stepId        String?              @map("step_id")
  campaignId    String?              @map("campaign_id")
  zaloAccountId String?              @map("zalo_account_id")
  content       String
  scheduledAt   DateTime             @map("scheduled_at")
  status        String               @default("pending")
  errorReason   String?              @map("error_reason")
  sentAt        DateTime?            @map("sent_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  campaign      Campaign?            @relation(fields: [campaignId], references: [id])
  contact       Contact              @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Cascade)
  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scenario      MessageScenario?     @relation(fields: [scenarioId], references: [id])
  step          MessageScenarioStep? @relation(fields: [stepId], references: [id])
  zaloAccount   ZaloAccount?         @relation(fields: [zaloAccountId], references: [id])

  @@unique([orgId, id])
  @@index([orgId, status, scheduledAt])
  @@index([contactId, scenarioId])
  @@map("scheduled_messages")
}

model AutomationWorkflow {
  id               String            @id @default(uuid())
  orgId            String            @map("org_id")
  name             String
  description      String?
  triggerTagId     String?           @map("trigger_tag_id")
  status           String            @default("draft")
  nodes            Json              @default("[]")
  edges            Json              @default("[]")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  createdBy        String?           @map("created_by")
  runs             AutomationRun[]
  creator          User?             @relation(fields: [orgId, createdBy], references: [orgId, id])
  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  triggerTag       Tag?              @relation(fields: [triggerTagId], references: [id])
  productWorkflows ProductWorkflow[]

  @@index([orgId, status])
  @@index([orgId, triggerTagId])
  @@map("automation_workflows")
}

model AutomationRun {
  id            String             @id @default(uuid())
  orgId         String             @map("org_id")
  workflowId    String             @map("workflow_id")
  contactId     String             @map("contact_id")
  status        String             @default("running")
  currentNodeId String?            @map("current_node_id")
  scheduledAt   DateTime?          @map("scheduled_at")
  state         Json               @default("{}")
  startedAt     DateTime           @default(now()) @map("started_at")
  completedAt   DateTime?          @map("completed_at")
  logs          AutomationLog[]
  contact       Contact            @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Cascade)
  org           Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflow      AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, contactId])
  @@index([orgId, status, scheduledAt])
  @@map("automation_runs")
}

model AutomationLog {
  id        String        @id @default(uuid())
  orgId     String        @map("org_id")
  runId     String        @map("run_id")
  nodeId    String        @map("node_id")
  nodeType  String        @map("node_type")
  status    String
  details   Json?
  createdAt DateTime      @default(now()) @map("created_at")
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  run       AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("automation_logs")
}

model Product {
  id               String            @id @default(uuid())
