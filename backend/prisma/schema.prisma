  organizations  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users          User?        @relation(fields: [orgId, toUserId], references: [orgId, id], onDelete: NoAction)

  @@index([orgId, contactId, createdAt])
  @@index([orgId, teamId, createdAt])
  @@index([orgId, toUserId, createdAt])
}

model Notification {
  id         String       @id
  orgId      String       @map("org_id")
  userId     String?      @map("user_id")
  teamId     String?      @map("team_id")
  type       String
  title      String
  detail     String
  priority   String       @default("medium")
  entityType String?      @map("entity_type")
  entityId   String?      @map("entity_id")
  readAt     DateTime?    @map("read_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [orgId, userId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, id])
  @@index([orgId, teamId, readAt])
  @@index([orgId, userId, readAt])
}

model ZaloConversationSyncState {
  id             String       @id
  orgId          String       @map("org_id")
  zaloAccountId  String       @map("zalo_account_id")
  conversationId String       @map("conversation_id")
  lastSyncedAt   DateTime?    @map("last_synced_at")
  lastMessageId  String?      @map("last_message_id")
  lastBackfillAt DateTime?    @map("last_backfill_at")
  syncStatus     String       @default("idle") @map("sync_status")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @map("updated_at")
  conversation   Conversation @relation(fields: [orgId, conversationId], references: [orgId, id], onDelete: Cascade)
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  zaloAccount    ZaloAccount  @relation(fields: [orgId, zaloAccountId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, conversationId])
  @@unique([orgId, id])
  @@unique([zaloAccountId, conversationId])
  @@index([orgId, lastSyncedAt])
  @@index([orgId, zaloAccountId, syncStatus])
}
