model AiActivityLog {
  id              String         @id
  orgId           String         @map("org_id")
  teamId          String?        @map("team_id")
  contactId       String?        @map("contact_id")
  conversationId  String?        @map("conversation_id")
  messageId       String?        @map("message_id")
  actorType       String         @map("actor_type")
  actorId         String?        @map("actor_id")
  actionType      String         @map("action_type")
  inputMessage    String?        @map("input_message")
  outputMessage   String?        @map("output_message")
  intent          String?
  confidence      Float?
  scenarioName    String?        @map("scenario_name")
  knowledgeSource String?        @map("knowledge_source")
  tagsAdded       String[]       @default([]) @map("tags_added")
  appointmentId   String?        @map("appointment_id")
  assignedUserId  String?        @map("assigned_user_id")
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now()) @map("created_at")
  users           User?          @relation(fields: [orgId, actorId], references: [orgId, id], onDelete: NoAction)
  contacts        Contact?       @relation(fields: [orgId, contactId], references: [orgId, id], onDelete: Cascade)
  conversations   Conversation?  @relation(fields: [orgId, conversationId], references: [orgId, id], onDelete: Cascade)
  organizations   Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  aiReviewItems   AiReviewItem[]

  @@unique([orgId, id])
  @@index([orgId, actionType, createdAt])
  @@index([orgId, assignedUserId, createdAt])
  @@index([orgId, contactId, createdAt])
  @@index([orgId, conversationId, createdAt])
  @@index([orgId, teamId, createdAt])
}

model AiKnowledge {
