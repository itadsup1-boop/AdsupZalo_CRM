# === Zalo Sales CRM ===
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001

# Security — generate strong random values for production
JWT_SECRET=4f9c52b1e7a6d8f3c9b2a1e4d7f0c5b8e9a4d2f1c8b3e7a6d5f0c1b4a9e2d3f
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

# Database
DB_USER=crmuser
DB_PASSWORD=password
DB_NAME=zalocrm
DATABASE_URL=postgresql://crmuser:devpassword@localhost:5433/zalocrm

# Storage
UPLOAD_DIR=/var/lib/zalo-crm/files

# AI — Global defaults (dùng Ollama local)
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=qwen2.5:3b

# AI Provider: Anthropic
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4.6
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4.6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4.5

# AI Provider: Gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_AUTH_TOKEN=
GEMINI_DEFAULT_PRO_MODEL=gemini-1.5-pro
GEMINI_DEFAULT_FLASH_MODEL=gemini-2.5-flash

# AI Provider: OpenAI (trỏ vào Ollama local)
OPENAI_BASE_URL=http://host.docker.internal:11434
OPENAI_AUTH_TOKEN=ollama
OPENAI_DEFAULT_GPT4O_MODEL=qwen2.5:3b
OPENAI_DEFAULT_GPT4O_MINI_MODEL=qwen2.5:3b

# AI Provider: Qwen
QWEN_BASE_URL=https://dashscope.aliyuncs.com
QWEN_AUTH_TOKEN=
QWEN_DEFAULT_PLUS_MODEL=qwen-plus
QWEN_DEFAULT_TURBO_MODEL=qwen-turbo
QWEN_DEFAULT_MAX_MODEL=qwen-max

# AI Provider: Kimi (Moonshot)
KIMI_BASE_URL=https://api.moonshot.cn
KIMI_AUTH_TOKEN=
KIMI_DEFAULT_MOONSHOT_V1_MODEL=moonshot-v1-8k

